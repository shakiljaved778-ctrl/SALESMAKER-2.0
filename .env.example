# SalesMaker local environment. Copy to .env and adjust. Every value here is a local-dev
# placeholder: never a real secret. Production secrets live in AWS Secrets Manager (§11.5).

# ── Databases ────────────────────────────────────────────────────────────────
# Migrations connect as the owner role (sm_migrator); the app as sm_app (no BYPASSRLS).
CELL_DATABASE_URL_MIGRATOR=postgresql://sm_migrator:sm_migrator_dev@localhost:5432/salesmaker_cell
CELL_DATABASE_URL=postgresql://sm_app:sm_app_dev@localhost:5432/salesmaker_cell
CP_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salesmaker_cp

# ── Cache / queues (Valkey, Redis protocol) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage (SeaweedFS S3 locally, S3 in AWS) ───────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=sm-dev-access
S3_SECRET_ACCESS_KEY=sm-dev-secret
S3_BUCKET=sm-eu-central-1-files

# ── Email (Mailpit locally; SES in AWS) ─────────────────────────────────────
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="SalesMaker <no-reply@salesmaker.localhost>"

# ── Cell identity ────────────────────────────────────────────────────────────
CELL_ID=eu-central-1
CELL_API_BASE_URL=http://localhost:4000
CONTROL_API_BASE_URL=http://localhost:4100
WEB_BASE_DOMAIN=localhost:3000

# ── Auth (dev keys are generated by `pnpm --filter @sm/api keys:dev`) ───────
AUTH_JWT_PRIVATE_KEY_PATH=./.secrets/jwt-ed25519.pem
AUTH_JWT_KID=dev-1
# Pepper for the control-plane email HMAC (Q2). Distinct per environment.
EMAIL_ROUTING_PEPPER=dev-only-pepper-change-me
# Local envelope-encryption key (32 bytes, base64). AWS KMS in deployed cells.
LOCAL_KMS_KEY=ZGV2LW9ubHkta2V5LTMyLWJ5dGVzLWxvbmctISEhISE=

# ── OIDC (points at apps/fakes locally) ─────────────────────────────────────
OIDC_GOOGLE_ISSUER=http://localhost:4200/google
OIDC_GOOGLE_CLIENT_ID=fake-google-client
OIDC_GOOGLE_CLIENT_SECRET=fake-google-secret
OIDC_MICROSOFT_ISSUER=http://localhost:4200/microsoft
OIDC_MICROSOFT_CLIENT_ID=fake-microsoft-client
OIDC_MICROSOFT_CLIENT_SECRET=fake-microsoft-secret
BREACHED_PASSWORD_API_URL=http://localhost:4200/hibp

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
