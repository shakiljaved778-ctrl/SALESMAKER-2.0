{
  "name": "@sm/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared ESLint, Prettier and TypeScript configuration for SalesMaker",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./eslint/plugin": "./eslint/plugin.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./vitest": {
      "types": "./vitest/coverage.d.ts",
      "default": "./vitest/coverage.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "17.12.0",
    "typescript-eslint": "8.70.1"
  },
  "peerDependencies": {
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "eslint": "10.11.0",
    "vitest": "5.0.2"
  }
}
