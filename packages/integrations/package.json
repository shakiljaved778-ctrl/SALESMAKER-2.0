  },
  "dependencies": {
    "nodemailer": "10.0.10",
    "openid-client": "6.8.8"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@types/node": "26.6.2",
    "@types/nodemailer": "8.0.2",
    "eslint": "10.11.0",
    "jose": "6.2.12",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
