{
  "name": "@sm/integrations",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Adapter interfaces for third-party services, with real and fake implementations (§10.5). No real third-party call ever happens in CI.",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@aws-sdk/s3-request-presigner": "3.1165.0",
    "html-to-text": "10.0.1",
    "mailparser": "3.14.3",
    "nodemailer": "10.5.0",
    "openid-client": "6.8.9"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "eslint": "10.14.0",
    "jose": "6.2.17",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
