    "fflate": "0.8.3",
    "kysely": "0.29.6",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
