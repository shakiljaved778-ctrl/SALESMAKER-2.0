{
  "name": "@sm/server-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared NestJS/Fastify plumbing for SalesMaker services: request context, logging with PII redaction, RFC 9457 errors, zod validation, rate limiting and telemetry (§3.6, §11.4)",
  "exports": {
    ".": "./dist/index.js",
    "./telemetry": "./dist/telemetry.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.81.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@sm/contracts": "workspace:*",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@swc/core": "1.16.18",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
