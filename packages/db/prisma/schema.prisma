// Cell database schema (one per regional cell, §3.4).
//
// Conventions (§4.1): UUIDv7 ids; tenant_id leads every primary key and index; timestamps are
// timestamptz in UTC; snake_case in SQL. Row-level security is not expressible in Prisma, so each
// migration enables it with enable_tenant_rls() and `pnpm db:rls-audit` enforces it.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum ThemePreference {
  light
  dark
  system

  @@map("theme_preference")
}

enum DensityPreference {
  comfortable
  default
  compact

  @@map("density_preference")
}

enum IdentityProvider {
  password
  google
  microsoft

  @@map("identity_provider")
}

enum MfaFactorType {
  totp

  @@map("mfa_factor_type")
}

enum AuthTokenPurpose {
  verify_email
  reset_password

  @@map("auth_token_purpose")
}

/// Global reference data (no tenant_id; allow-listed in the RLS audit).
model Currency {
  code       String @id @db.Char(3)
  name       String
  minorUnits Int    @map("minor_units") @db.SmallInt

  @@map("currency")
}

model TenantSettings {
  tenantId             String    @id @map("tenant_id") @db.Uuid
  name                 String
  slug                 String    @db.Citext
  region               String
  corporateCurrency    String    @map("corporate_currency") @db.Char(3)
  defaultLocale        String    @default("en") @map("default_locale")
  defaultTimezone      String    @map("default_timezone")
  fiscalYearStartMonth Int       @default(1) @map("fiscal_year_start_month") @db.SmallInt
  metadataVersion      Int       @default(1) @map("metadata_version")
  permVersion          Int       @default(1) @map("perm_version")
  logoFileId           String?   @map("logo_file_id") @db.Uuid
  /// The user who created the organisation at signup.
  ownerUserId          String?   @map("owner_user_id") @db.Uuid
  /// Set once the control plane has activated the tenant (owner verified, §7.20a).
  activatedAt          DateTime? @map("activated_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version              Int       @default(1)

  @@map("tenant_settings")
}

model User {
  tenantId        String            @map("tenant_id") @db.Uuid
  id              String            @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email           String            @db.Citext
  emailVerifiedAt DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  name            String
  locale          String?
  timezone        String?
  theme           ThemePreference   @default(system)
  density         DensityPreference @default(default)
  status          UserStatus        @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?           @map("created_by") @db.Uuid
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?           @map("updated_by") @db.Uuid
  version         Int               @default(1)
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  /// Position in the org hierarchy (§6.3): drives hierarchy access and role-based sharing rules.
  orgUnitId       String?           @map("org_unit_id") @db.Uuid
  /// Direct manager; managers see their direct reports' records. Cycles are rejected by a trigger.
  managerId       String?           @map("manager_id") @db.Uuid
  title           String?
  department      String?
  phone           String?
  /// The user's profile (§6.2): their baseline permissions. Every active user has one.
  profileId       String?           @map("profile_id") @db.Uuid
  /// Set when an admin deactivates the user (sessions revoked, cannot sign in, records kept).
  deactivatedAt   DateTime?         @map("deactivated_at") @db.Timestamptz(6)

  orgUnit               OrgUnit?               @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Restrict)
  profile               Profile?               @relation(fields: [tenantId, profileId], references: [tenantId, id], onDelete: Restrict)
  permissionAssignments PermissionAssignment[]
  manager               User?                  @relation("UserManager", fields: [tenantId, managerId], references: [tenantId, id], onDelete: Restrict)
  directReports         User[]                 @relation("UserManager")
  identities            UserIdentity[]
  sessions              Session[]
  mfaFactors            MfaFactor[]
  recoveryCodes         MfaRecoveryCode[]
  authTokens            AuthToken[]
  groupMembers          GroupMember[]
  queueMembers          QueueMember[]

  @@id([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId, orgUnitId])
  @@index([tenantId, managerId])
  @@index([tenantId, profileId])
  @@map("user")
}

/// Org hierarchy node (§6.3, the Salesforce "role"). The tree is mirrored in org_unit_closure by
/// triggers in the same transaction; moving a unit under its own subtree is rejected.
model OrgUnit {
  tenantId    String    @map("tenant_id") @db.Uuid
  id          String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent       OrgUnit?         @relation("OrgUnitTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children     OrgUnit[]        @relation("OrgUnitTree")
  users        User[]
  groupMembers GroupMember[]
  queueMembers QueueMember[]
  ancestors    OrgUnitClosure[] @relation("ClosureDescendant")
  descendants  OrgUnitClosure[] @relation("ClosureAncestor")

  @@id([tenantId, id])
  @@index([tenantId, parentId])
  @@map("org_unit")
}

/// Every (ancestor, descendant) pair of the org hierarchy, including (unit, unit) at depth 0.
/// Written only by the org_unit triggers.
model OrgUnitClosure {
  tenantId     String @map("tenant_id") @db.Uuid
  ancestorId   String @map("ancestor_id") @db.Uuid
  descendantId String @map("descendant_id") @db.Uuid
  depth        Int

  ancestor   OrgUnit @relation("ClosureAncestor", fields: [tenantId, ancestorId], references: [tenantId, id], onDelete: Cascade)
  descendant OrgUnit @relation("ClosureDescendant", fields: [tenantId, descendantId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, ancestorId, descendantId])
  @@index([tenantId, descendantId, depth])
  @@map("org_unit_closure")
}

model UserIdentity {
  tenantId     String           @map("tenant_id") @db.Uuid
  id           String           @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  provider     IdentityProvider
  subject      String
  passwordHash String?          @map("password_hash")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@unique([tenantId, provider, subject])
  @@index([tenantId, userId])
  @@map("user_identity")
}

model Session {
  tenantId    String    @map("tenant_id") @db.Uuid
  id          String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ip          String?
  userAgent   String?   @map("user_agent")
  mfaVerified Boolean   @default(false) @map("mfa_verified")
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  user          User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@id([tenantId, id])
  @@index([tenantId, userId])
  @@map("session")
}

/// Rotating refresh tokens. All tokens of one login share a family_id; presenting a token that
/// was already used revokes the whole family (reuse detection, §6.1).
model RefreshToken {
  tenantId  String    @map("tenant_id") @db.Uuid
  id        String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  parentId  String?   @map("parent_id") @db.Uuid
  tokenHash Bytes     @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session Session @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@unique([tenantId, tokenHash])
  @@index([tenantId, familyId])
  @@map("refresh_token")
}

model MfaFactor {
  tenantId     String        @map("tenant_id") @db.Uuid
  id           String        @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  type         MfaFactorType
  /// Envelope-encrypted secret: `<keyId>:<base64 ciphertext>` (§6.6).
  secretEnc    String        @map("secret_enc")
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  /// Last TOTP time step accepted; a code can never be used twice (replay protection).
  lastUsedStep BigInt?       @map("last_used_step")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, userId])
  @@map("mfa_factor")
}

model MfaRecoveryCode {
  tenantId  String    @map("tenant_id") @db.Uuid
  id        String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  Bytes     @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId, userId])
  @@map("mfa_recovery_code")
}

model AuthToken {
  tenantId  String           @map("tenant_id") @db.Uuid
  id        String           @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash Bytes            @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@unique([tenantId, tokenHash])
  @@index([tenantId, userId, purpose])
  @@map("auth_token")
}

/// Login attempts for lockout (10 failures / 15 min, §6.1). Becomes login_history in P01.
model AuthAttempt {
  tenantId    String    @map("tenant_id") @db.Uuid
  id          String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String?   @map("user_id") @db.Uuid
  emailHash   Bytes     @map("email_hash")
  ip          String?
  success     Boolean
  at          DateTime  @default(now()) @db.Timestamptz(6)
  /// Set on the failure that triggered a lockout: sign-in is refused until then (§6.1).
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@index([tenantId, emailHash, at])
  @@map("auth_attempt")
}

model IdempotencyKey {
  tenantId       String   @map("tenant_id") @db.Uuid
  key            String
  requestHash    Bytes    @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, key])
  @@index([tenantId, expiresAt])
  @@map("idempotency_key")
}

enum PermissionSetKind {
  /// The grants of one profile (every profile owns exactly one).
  PROFILE
  /// An assignable, additive permission set.
  STANDARD
  /// Subtracts from the sets of the one permission set group that owns it (§6.2).
  MUTING

  @@map("permission_set_kind")
}

/// A user's baseline permissions (§6.2). Its grants live in its own PROFILE permission set.
model Profile {
  tenantId        String    @map("tenant_id") @db.Uuid
  id              String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name            String
  description     String?
  /// Built-in profile key (system_administrator, standard_user, read_only); null for custom ones.
  systemKey       String?   @map("system_key")
  permissionSetId String    @map("permission_set_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy       String?   @map("updated_by") @db.Uuid
  version         Int       @default(1)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  permissionSet PermissionSet @relation(fields: [tenantId, permissionSetId], references: [tenantId, id], onDelete: Restrict)
  users         User[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@unique([tenantId, systemKey])
  @@unique([tenantId, permissionSetId])
  @@map("profile")
}

/// A bundle of grants (§6.2): system, object and field permissions.
model PermissionSet {
  tenantId    String            @map("tenant_id") @db.Uuid
  id          String            @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  kind        PermissionSetKind @default(STANDARD)
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?           @map("created_by") @db.Uuid
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?           @map("updated_by") @db.Uuid
  version     Int               @default(1)
  deletedAt   DateTime?         @map("deleted_at") @db.Timestamptz(6)

  profile           Profile?
  systemPermissions SystemPermission[]
  objectPermissions ObjectPermission[]
  fieldPermissions  FieldPermission[]
  groupMemberships  PermissionSetGroupMember[]
  mutingFor         PermissionSetGroup?
  assignments       PermissionAssignment[]

  @@id([tenantId, id])
  @@unique([tenantId, kind, name])
  @@map("permission_set")
}

/// Bundles permission sets; its optional muting set removes grants from those sets only.
model PermissionSetGroup {
  tenantId    String    @map("tenant_id") @db.Uuid
  id          String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String
  description String?
  mutingSetId String?   @map("muting_set_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  mutingSet   PermissionSet?             @relation(fields: [tenantId, mutingSetId], references: [tenantId, id], onDelete: Restrict)
  members     PermissionSetGroupMember[]
  assignments PermissionAssignment[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@unique([tenantId, mutingSetId])
  @@map("permission_set_group")
}

model PermissionSetGroupMember {
  tenantId        String   @map("tenant_id") @db.Uuid
  groupId         String   @map("group_id") @db.Uuid
  permissionSetId String   @map("permission_set_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by") @db.Uuid

  group         PermissionSetGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  permissionSet PermissionSet      @relation(fields: [tenantId, permissionSetId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, groupId, permissionSetId])
  @@index([tenantId, permissionSetId])
  @@map("permission_set_group_member")
}

/// Gives a user a permission set or a permission set group (exactly one of the two).
model PermissionAssignment {
  tenantId             String   @map("tenant_id") @db.Uuid
  id                   String   @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  permissionSetId      String?  @map("permission_set_id") @db.Uuid
  permissionSetGroupId String?  @map("permission_set_group_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            String?  @map("created_by") @db.Uuid

  user               User                @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  permissionSet      PermissionSet?      @relation(fields: [tenantId, permissionSetId], references: [tenantId, id], onDelete: Restrict)
  permissionSetGroup PermissionSetGroup? @relation(fields: [tenantId, permissionSetGroupId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, id])
  @@unique([tenantId, userId, permissionSetId])
  @@unique([tenantId, userId, permissionSetGroupId])
  @@index([tenantId, permissionSetId])
  @@index([tenantId, permissionSetGroupId])
  @@map("permission_assignment")
}

/// A system permission (§6.2 layer 2) granted by a permission set. Names are validated by
/// @sm/permissions; unknown names are ignored by the engine.
model SystemPermission {
  tenantId        String @map("tenant_id") @db.Uuid
  permissionSetId String @map("permission_set_id") @db.Uuid
  name            String

  permissionSet PermissionSet @relation(fields: [tenantId, permissionSetId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, permissionSetId, name])
  @@map("system_permission")
}

/// Object permissions (§6.2 layer 3) of one permission set on one object (by API name).
model ObjectPermission {
  tenantId        String  @map("tenant_id") @db.Uuid
  permissionSetId String  @map("permission_set_id") @db.Uuid
  object          String
  canRead         Boolean @default(false) @map("can_read")
  canCreate       Boolean @default(false) @map("can_create")
  canEdit         Boolean @default(false) @map("can_edit")
  canDelete       Boolean @default(false) @map("can_delete")
  viewAll         Boolean @default(false) @map("view_all")
  modifyAll       Boolean @default(false) @map("modify_all")

  permissionSet PermissionSet @relation(fields: [tenantId, permissionSetId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, permissionSetId, object])
  @@map("object_permission")
}

/// Field-level security (§6.2 layer 5) of one permission set on one field.
model FieldPermission {
  tenantId        String  @map("tenant_id") @db.Uuid
  permissionSetId String  @map("permission_set_id") @db.Uuid
  object          String
  field           String
  canRead         Boolean @default(false) @map("can_read")
  canEdit         Boolean @default(false) @map("can_edit")

  permissionSet PermissionSet @relation(fields: [tenantId, permissionSetId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, permissionSetId, object, field])
  @@map("field_permission")
}

/// Who a public group or queue member row stands for (§6.3, Salesforce semantics).
enum MemberType {
  USER
  /// Every member of another public group (transitively).
  GROUP
  /// Users placed in exactly this org unit.
  ORG_UNIT
  /// Users in this org unit or any unit below it.
  ORG_UNIT_AND_SUBORDINATES

  @@map("member_type")
}

/// A public group (§6.3): a named set of users used by sharing rules, manual shares and queues.
model PublicGroup {
  tenantId    String    @map("tenant_id") @db.Uuid
  id          String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  members  GroupMember[] @relation("GroupMembers")
  memberOf GroupMember[] @relation("NestedGroup")
  inQueues QueueMember[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("public_group")
}

/// One member of a public group: a user, another group, an org unit, or an org unit and below.
model GroupMember {
  tenantId      String     @map("tenant_id") @db.Uuid
  id            String     @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  groupId       String     @map("group_id") @db.Uuid
  memberType    MemberType @map("member_type")
  userId        String?    @map("user_id") @db.Uuid
  memberGroupId String?    @map("member_group_id") @db.Uuid
  orgUnitId     String?    @map("org_unit_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?    @map("created_by") @db.Uuid

  group       PublicGroup  @relation("GroupMembers", fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  user        User?        @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  memberGroup PublicGroup? @relation("NestedGroup", fields: [tenantId, memberGroupId], references: [tenantId, id], onDelete: Cascade)
  orgUnit     OrgUnit?     @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@unique([tenantId, groupId, userId])
  @@unique([tenantId, groupId, memberGroupId])
  @@unique([tenantId, groupId, memberType, orgUnitId])
  @@index([tenantId, userId])
  @@index([tenantId, memberGroupId])
  @@index([tenantId, orgUnitId])
  @@map("group_member")
}

/// A queue (§6.3): owns records until a member takes them; members see what the queue owns.
model Queue {
  tenantId    String    @map("tenant_id") @db.Uuid
  id          String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String
  email       String?   @db.Citext
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?   @map("updated_by") @db.Uuid
  version     Int       @default(1)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  members QueueMember[]
  objects QueueObject[]

  @@id([tenantId, id])
  @@unique([tenantId, name])
  @@map("queue")
}

model QueueMember {
  tenantId      String     @map("tenant_id") @db.Uuid
  id            String     @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  queueId       String     @map("queue_id") @db.Uuid
  memberType    MemberType @map("member_type")
  userId        String?    @map("user_id") @db.Uuid
  memberGroupId String?    @map("member_group_id") @db.Uuid
  orgUnitId     String?    @map("org_unit_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?    @map("created_by") @db.Uuid

  queue       Queue        @relation(fields: [tenantId, queueId], references: [tenantId, id], onDelete: Cascade)
  user        User?        @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  memberGroup PublicGroup? @relation(fields: [tenantId, memberGroupId], references: [tenantId, id], onDelete: Cascade)
  orgUnit     OrgUnit?     @relation(fields: [tenantId, orgUnitId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, id])
  @@unique([tenantId, queueId, userId])
  @@unique([tenantId, queueId, memberGroupId])
  @@unique([tenantId, queueId, memberType, orgUnitId])
  @@index([tenantId, userId])
  @@index([tenantId, memberGroupId])
  @@index([tenantId, orgUnitId])
  @@map("queue_member")
}

/// The objects whose records a queue may own (by API name).
model QueueObject {
  tenantId String @map("tenant_id") @db.Uuid
  queueId  String @map("queue_id") @db.Uuid
  object   String

  queue Queue @relation(fields: [tenantId, queueId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, queueId, object])
  @@index([tenantId, object])
  @@map("queue_object")
}

/// Transactional outbox (§3.7, §3.9): written in the same transaction as the change it announces,
/// published to BullMQ by the worker's relay after commit. Partitioned by day (created_at), kept
/// for 7 days; partitions are created and dropped by outbox_maintain_partitions().
model OutboxEvent {
  tenantId      String    @map("tenant_id") @db.Uuid
  id            String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Insert order: events of one transaction share created_at, and consumers see them in order.
  seq           BigInt    @default(autoincrement())
  /// `<queue>.<event>`, e.g. `sharing.owner_changed`; the prefix picks the BullMQ queue.
  topic         String
  aggregateType String?   @map("aggregate_type")
  aggregateId   String?   @map("aggregate_id") @db.Uuid
  payload       Json      @default("{}")
  /// Set by the relay once the job is in BullMQ (at-least-once; the job id is this row's id).
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@id([tenantId, createdAt, id])
  @@index([tenantId, publishedAt, createdAt])
  @@map("outbox_event")
}

/// Org-wide default sharing (§6.3), per object API name.
enum SharingModel {
  PRIVATE
  PUBLIC_READ
  PUBLIC_READ_WRITE
  CONTROLLED_BY_PARENT

  @@map("sharing_model")
}

/// The baseline record access for an object. Standard objects get a row at signup; an object
/// without one uses its catalogue default (custom objects: PRIVATE).
model OrgWideDefault {
  tenantId       String       @map("tenant_id") @db.Uuid
  object         String
  sharingModel   SharingModel @map("sharing_model")
  /// "Grant access using hierarchies": managers see their subordinates' records.
  grantHierarchy Boolean      @default(true) @map("grant_hierarchy")
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String?      @map("updated_by") @db.Uuid
  version        Int          @default(1)

  @@id([tenantId, object])
  @@map("org_wide_default")
}

/// For each viewer, every owner whose records hierarchy access lets them see (§6.4): themselves,
/// users in org units below theirs, their direct reports, and the queues they belong to.
/// Written only by rebuild_user_visibility().
model UserVisibilityClosure {
  tenantId     String @map("tenant_id") @db.Uuid
  viewerUserId String @map("viewer_user_id") @db.Uuid
  ownerId      String @map("owner_id") @db.Uuid

  @@id([tenantId, viewerUserId, ownerId])
  @@index([tenantId, ownerId])
  @@map("user_visibility_closure")
}

/// Who a share or a sharing rule names (§6.3, §6.4).
enum SharePrincipalType {
  USER
  GROUP
  QUEUE
  /// Users in exactly this org unit (a Salesforce "role").
  ORG_UNIT
  /// Users in this org unit or any unit below it.
  ORG_UNIT_AND_SUBORDINATES

  @@map("share_principal_type")
}

/// Why a share exists (§6.4).
enum ShareReason {
  RULE
  MANUAL
  TEAM
  TERRITORY
  IMPLICIT_PARENT
  IMPLICIT_CHILD

  @@map("share_reason")
}

enum SharingRuleKind {
  /// Records owned by members of a group or org unit.
  OWNER
  /// Records that match a filter.
  CRITERIA

  @@map("sharing_rule_kind")
}

/// An explicit grant of access to one record (§6.4), LIST-partitioned by object. `access` is 1 Read,
/// 2 Read-Write, 3 Full. `source_id` names what created it (the rule, team membership, territory or
/// parent record), and the nil UUID for manual shares, so each source grants a principal once.
model RecordShare {
  tenantId      String             @map("tenant_id") @db.Uuid
  object        String
  id            String             @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  recordId      String             @map("record_id") @db.Uuid
  principalType SharePrincipalType @map("principal_type")
  principalId   String             @map("principal_id") @db.Uuid
  access        Int                @db.SmallInt
  reason        ShareReason
  sourceId      String             @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @map("source_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?            @map("created_by") @db.Uuid

  @@id([tenantId, object, id])
  @@unique([tenantId, object, recordId, principalType, principalId, reason, sourceId])
  @@index([tenantId, object, principalId, recordId])
  @@index([tenantId, object, reason, sourceId])
  @@map("record_share")
}

/// A sharing rule (§6.3): owner-based (records owned by members of `source`) or criteria-based
/// (records matching `criteria`), shared with `target` at Read or Read-Write.
model SharingRule {
  tenantId    String              @map("tenant_id") @db.Uuid
  id          String              @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  object      String
  name        String
  description String?
  kind        SharingRuleKind
  sourceType  SharePrincipalType? @map("source_type")
  sourceId    String?             @map("source_id") @db.Uuid
  /// Filter tree (@sm/query-engine FilterNode) for criteria rules.
  criteria    Json?
  targetType  SharePrincipalType  @map("target_type")
  targetId    String              @map("target_id") @db.Uuid
  access      Int                 @db.SmallInt
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   String?             @map("created_by") @db.Uuid
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy   String?             @map("updated_by") @db.Uuid
  version     Int                 @default(1)

  @@id([tenantId, id])
  @@unique([tenantId, object, name])
  @@index([tenantId, object, active])
  @@map("sharing_rule")
}

enum JobRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@map("job_run_status")
}

/// Progress of a long tenant job (sharing recalculation, imports, …) for Setup to show.
model JobRun {
  tenantId   String       @map("tenant_id") @db.Uuid
  id         String       @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  kind       String
  subjectId  String?      @map("subject_id") @db.Uuid
  status     JobRunStatus @default(QUEUED)
  done       Int          @default(0)
  total      Int?
  error      String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy  String?      @map("created_by") @db.Uuid
  startedAt  DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@index([tenantId, kind, subjectId, createdAt])
  @@map("job_run")
}

/// Append-only, hash-chained audit log (§4.2, ADR-0008 + addendum), partitioned monthly on
/// occurred_at. Audited transactions insert rows with the next per-tenant `seq` and no hash; the
/// worker's chain job later sets `prev_hash` / `hash` (as sm_audit, exactly once) in seq order.
model AuditLog {
  tenantId   String    @map("tenant_id") @db.Uuid
  id         String    @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  /// Wall-clock insert time: how old an uncommitted gap before this row can be.
  insertedAt DateTime  @default(dbgenerated("clock_timestamp()")) @map("inserted_at") @db.Timestamptz(6)
  seq        BigInt    @default(dbgenerated("audit_next_seq()"))
  /// user, system, agent or support (§6.7, §8).
  actorType  String    @map("actor_type")
  actorId    String?   @map("actor_id") @db.Uuid
  /// For agents and support: the user they acted for or under.
  onBehalfOf String?   @map("on_behalf_of") @db.Uuid
  action     String
  object     String?
  recordId   String?   @map("record_id") @db.Uuid
  payload    Json      @default("{}")
  requestId  String?   @map("request_id")
  prevHash   String?   @map("prev_hash")
  hash       String?
  chainedAt  DateTime? @map("chained_at") @db.Timestamptz(6)

  @@id([tenantId, occurredAt, id])
  @@index([tenantId, seq])
  @@index([tenantId, object, recordId, occurredAt])
  @@index([tenantId, actorId, occurredAt])
  @@map("audit_log")
}

/// One chaining step: the rows first_seq..last_seq (minus declared gaps), their Merkle root, and the
/// previous batch's root, so the batches form a chain of their own.
model AuditBatch {
  tenantId   String   @map("tenant_id") @db.Uuid
  id         String   @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  firstSeq   BigInt   @map("first_seq")
  lastSeq    BigInt   @map("last_seq")
  rowCount   Int      @map("row_count")
  /// Sequence numbers that were never committed (rolled back), declared explicitly.
  gaps       BigInt[] @default([])
  headHash   String   @map("head_hash")
  merkleRoot String   @map("merkle_root")
  prevRoot   String?  @map("prev_root")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, id])
  @@unique([tenantId, lastSeq])
  @@map("audit_batch")
}

enum AuditVerificationStatus {
  OK
  BROKEN

  @@map("audit_verification_status")
}

/// A verifier run: how far the chain was re-walked and whether it held.
model AuditVerification {
  tenantId   String                  @map("tenant_id") @db.Uuid
  id         String                  @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  startedAt  DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime                @default(now()) @map("finished_at") @db.Timestamptz(6)
  status     AuditVerificationStatus
  throughSeq BigInt?                 @map("through_seq")
  batches    Int
  rows       Int
  /// Rows written but not chained yet (normal for a few seconds after a write).
  pending    Int
  problem    String?

  @@id([tenantId, id])
  @@index([tenantId, startedAt])
  @@map("audit_verification")
}

/// Setup audit trail (§5.6, §6.7): every configuration change with before/after JSON.
model SetupAudit {
  tenantId   String   @map("tenant_id") @db.Uuid
  id         String   @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId    String?  @map("actor_id") @db.Uuid
  /// e.g. `profile.updated`, `sharing_rule.created`.
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  entityName String?  @map("entity_name")
  before     Json?
  after      Json?
  requestId  String?  @map("request_id")

  @@id([tenantId, id])
  @@index([tenantId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@map("setup_audit")
}

enum LoginMethod {
  password
  google
  microsoft
  otp
  recovery_code

  @@map("login_method")
}

enum LoginOutcome {
  SUCCESS
  MFA_REQUIRED
  INVALID_CREDENTIALS
  INVALID_CODE
  LOCKED
  EMAIL_NOT_VERIFIED
  NO_ACCOUNT

  @@map("login_outcome")
}

/// Every sign-in attempt and its outcome (§6.1, §6.7). Unknown addresses are kept only as the
/// email HMAC (like auth_attempt), never in plain text.
model LoginHistory {
  tenantId   String       @map("tenant_id") @db.Uuid
  id         String       @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)
  userId     String?      @map("user_id") @db.Uuid
  emailHash  Bytes?       @map("email_hash")
  method     LoginMethod
  outcome    LoginOutcome
  sessionId  String?      @map("session_id") @db.Uuid
  ip         String?
  userAgent  String?      @map("user_agent")

  @@id([tenantId, id])
  @@index([tenantId, occurredAt])
  @@index([tenantId, userId, occurredAt])
  @@map("login_history")
}
