{
  "name": "@sm/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cell database: Prisma schema and migrations, roles, RLS helpers and the tenant transaction wrapper",
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "db:bootstrap": "node scripts/bootstrap.js",
    "db:migrate": "prisma migrate deploy",
    "db:schema-drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "db:rls-audit": "node scripts/rls-audit.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "kysely": "0.29.6",
    "pg": "8.23.0",
    "uuidv7": "1.2.1",
    "@testcontainers/postgresql": "12.1.0"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "testcontainers": "12.1.0",
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
