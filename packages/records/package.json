{
  "name": "@sm/records",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RecordService (§3.7): the only write path for CRM records. Permission, FLS and record-access checks, defaults, auto-numbers, validation rules, optimistic concurrency, money, field history, audit and outbox events, in the caller's tenant transaction.",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@sm/db": "workspace:*",
    "@sm/formula": "workspace:*",
    "@sm/metadata": "workspace:*",
    "@sm/permissions": "workspace:*",
    "@sm/query-engine": "workspace:*",
    "decimal.js": "10.6.0",
    "kysely": "0.29.6"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
