{
  "name": "@sm/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Message catalogues (ICU MessageFormat), locale metadata, pseudo-locales and the i18n key check (§9.12, golden rule 5)",
  "exports": {
    ".": "./dist/index.js",
    "./messages/*": "./messages/*"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/i18n.js generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "i18n:check": "node scripts/i18n.js check"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.20",
    "use-intl": "4.14.7"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
