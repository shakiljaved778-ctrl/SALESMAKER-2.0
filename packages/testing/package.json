{
  "name": "@sm/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test support shared across the repo: fake third-party servers (OIDC IdPs, HIBP range API) used by apps/fakes, integration tests and e2e (\u00a710.5, \u00a713.3), and data factories (makeTenantWithHierarchy).",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.2",
    "@sm/db": "workspace:*",
    "@sm/server-kit": "workspace:*",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@sm/integrations": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "openid-client": "6.9.1",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
