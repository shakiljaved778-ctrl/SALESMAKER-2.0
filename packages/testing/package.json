{
  "name": "@sm/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Test support shared across the repo: fake third-party servers (OIDC IdPs, HIBP range API) used by apps/fakes, integration tests and e2e (§10.5, §13.3). Factories join in P01+.",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.0",
    "@sm/server-kit": "workspace:*",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "uuidv7": "1.2.1"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@sm/integrations": "workspace:*",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "openid-client": "6.8.8",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
