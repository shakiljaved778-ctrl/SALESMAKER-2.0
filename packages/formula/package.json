{
  "name": "@sm/formula",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The SalesMaker expression language (§5.5): parser, type checker, evaluator and the SQL compiler for filters. One safe language for formula fields, validation rules and automation conditions.",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@sm/metadata": "workspace:*",
    "decimal.js": "10.6.0",
    "kysely": "0.29.6"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@sm/db": "workspace:*",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
