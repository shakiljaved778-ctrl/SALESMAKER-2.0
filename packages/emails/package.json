{
  "name": "@sm/emails",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "System email templates (React Email): always light, dark-mode safe, copy from @sm/i18n (§3.2, §9.6)",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.1",
    "@sm/i18n": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
