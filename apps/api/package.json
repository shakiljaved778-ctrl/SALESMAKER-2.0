{
  "name": "@sm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cell API (NestJS on Fastify): the regional data plane (§3.1, §3.6)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "openapi:write": "node scripts/write-openapi.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@sm/contracts": "workspace:*",
    "@sm/db": "workspace:*",
    "@sm/server-kit": "workspace:*",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@swc/core": "1.16.2",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
