{
  "name": "@sm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cell API (NestJS on Fastify): the regional data plane (§3.1, §3.6)",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "openapi:write": "node scripts/write-openapi.js",
    "perf:records": "node --env-file-if-exists=../../.env scripts/perf-records.js",
    "perf:sharing": "node --env-file-if-exists=../../.env scripts/perf-sharing.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@sm/contracts": "workspace:*",
    "@sm/db": "workspace:*",
    "@sm/emails": "workspace:*",
    "@sm/formula": "workspace:*",
    "@sm/i18n": "workspace:*",
    "@sm/imports": "workspace:*",
    "@sm/integrations": "workspace:*",
    "@sm/metadata": "workspace:*",
    "@sm/permissions": "workspace:*",
    "@sm/query-engine": "workspace:*",
    "@sm/records": "workspace:*",
    "@sm/server-kit": "workspace:*",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "otplib": "13.5.0",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@sm/testing": "workspace:*",
    "@swc/core": "1.16.18",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "pg": "8.23.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.4"
  }
}
