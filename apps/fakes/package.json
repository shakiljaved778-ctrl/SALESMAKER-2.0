{
  "name": "@sm/fakes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Serves the local stand-ins for third-party services from @sm/testing (fake Google/Microsoft OIDC, HIBP range API) on :4200 for dev and e2e, so no real third-party call is ever made (\u00a710.5, \u00a713.6).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "echo \"fakes are tested in @sm/testing\""
  },
  "dependencies": {
    "@sm/testing": "workspace:*"
  },
  "devDependencies": {
    "@sm/config": "workspace:*",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
