{
  "openapi": "3.1.0",
  "info": {
    "title": "SalesMaker control plane API",
    "version": "1.0.0",
    "description": "Global tenant directory and routing. Internal: called by the web app and by cells."
  },
  "paths": {
    "/cp/v1/cells": {
      "get": {
        "operationId": "listCells",
        "summary": "Data regions a new organisation can choose",
        "tags": [
          "tenants"
        ],
        "x-sm-visibility": "internal",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Cells",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cells": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CellSummary"
                      }
                    }
                  },
                  "required": [
                    "cells"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned for resources in another tenant, so existence is not leaked)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/cp/v1/cells/self/tenants": {
      "get": {
        "operationId": "listCellTenants",
        "summary": "Ids of every tenant hosted by the calling cell (for cell-wide background sweeps)",
        "tags": [
          "tenants"
        ],
        "x-sm-visibility": "internal",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Return tenant ids after this one (cursor from `next`)",
              "$ref": "#/components/schemas/Uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "default": 500,
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of tenant ids, in id order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CellTenantPage"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned for resources in another tenant, so existence is not leaked)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "serviceToken": []
          }
        ]
      }
    },
    "/cp/v1/tenants/{tenantId}/activate": {
      "post": {
        "operationId": "activateTenant",
