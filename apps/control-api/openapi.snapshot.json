  },
  "components": {
    "schemas": {
      "CellSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "apiBaseUrl": {
            "type": "string",
            "format": "uri"
          },
          "signupOpen": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "region",
          "label",
          "apiBaseUrl",
          "signupOpen"
        ],
        "additionalProperties": false
      },
      "CellTenantPage": {
        "type": "object",
        "properties": {
          "tenantIds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Uuid"
            }
          },
          "next": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Uuid"
              },
              {
                "type": "null"
              }
            ],
            "description": "Cursor for the next page, or null on the last page"
          }
        },
        "required": [
          "tenantIds",
          "next"
        ],
        "additionalProperties": false
      },
      "Email": {
        "type": "string",
        "maxLength": 254,
        "format": "email",
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
      },
      "EmailHmac": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{43}$"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "validation_failed",
          "unauthenticated",
          "forbidden",
          "not_found",
          "conflict",
          "version_conflict",
          "rate_limited",
          "idempotency_key_reused",
          "mfa_required",
          "account_locked",
          "email_not_verified",
          "service_unavailable",
          "internal_error"
        ]
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Dotted path of the offending field, e.g. \"billing.country\""
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ],
        "additionalProperties": false
      },
      "FindWorkspacesRequest": {
        "type": "object",
        "properties": {
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "locale": {
            "type": "string",
            "maxLength": 16
          }
        },
        "required": [
          "email"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string"
          },
          "cell": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "cell"
        ],
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI reference identifying the problem type"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "traceId": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": false
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "degraded"
            ]
          },
          "checks": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "ok",
                "failing"
              ]
            }
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      },
      "ReservedTenant": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "slug": {
            "$ref": "#/components/schemas/TenantSlug"
          },
          "status": {
            "$ref": "#/components/schemas/TenantStatus"
          },
          "cellId": {
            "type": "string"
          }
        },
        "required": [
          "tenantId",
          "slug",
          "status",
          "cellId"
        ],
        "additionalProperties": false
      },
      "ReserveTenantRequest": {
        "type": "object",
        "properties": {
          "slug": {
            "$ref": "#/components/schemas/TenantSlug"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "ownerEmailHmac": {
            "$ref": "#/components/schemas/EmailHmac"
          }
        },
        "required": [
          "slug",
          "name",
          "ownerEmailHmac"
        ]
      },
      "ResolvedTenant": {
        "type": "object",
        "properties": {
          "tenantId": {
            "$ref": "#/components/schemas/Uuid"
          },
          "slug": {
            "$ref": "#/components/schemas/TenantSlug"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TenantStatus"
          },
          "cell": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "apiBaseUrl": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "id",
              "apiBaseUrl"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "tenantId",
          "slug",
          "name",
          "status",
          "cell"
        ],
        "additionalProperties": false
      },
      "TenantSlug": {
        "type": "string",
        "pattern": "^(?=.{3,40}$)[a-z0-9]+(?:-[a-z0-9]+)*$",
        "example": "pixelcraft"
      },
      "TenantStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "ACTIVE",
          "SUSPENDED"
        ]
      },
      "Uuid": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "description": "UUIDv7 identifier",
        "example": "01920000-0000-7000-8000-000000000001"
      }
    },
