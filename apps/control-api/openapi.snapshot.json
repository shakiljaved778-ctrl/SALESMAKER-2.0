                }
              }
            }
          }
        }
      }
    },
    "/cp/v1/workspaces/find": {
      "post": {
        "operationId": "findWorkspaces",
        "summary": "Email the caller the workspaces their address belongs to (always 202)",
        "tags": [
          "tenants"
        ],
        "x-sm-visibility": "internal",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Accepted; an email is sent if any workspace matches"
          },
          "400": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not found (also returned for resources in another tenant, so existence is not leaked)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindWorkspacesRequest"
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
