# Copy to infra/demo/demo.env (gitignored) and fill in the five values marked ← .
# Guide: docs/runbooks/demo-hosting.md

# ← Neon: connection strings of the project's owner role (Dashboard → Connect), "Connection
#   pooling" OFF, one per database. Create the two databases first (Databases → New database).
NEON_CELL_URL=postgresql://neondb_owner:password@ep-example-123456.eu-central-1.aws.neon.tech/salesmaker_cell?sslmode=require
NEON_CP_URL=postgresql://neondb_owner:password@ep-example-123456.eu-central-1.aws.neon.tech/salesmaker_cp?sslmode=require

# ← ngrok: Dashboard → Your Authtoken, and Domains → your free static domain (no https://).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=example-name.ngrok-free.app

# ← The Vercel project's address (no https://). Workspaces are reached through the aliases below.
WEB_BASE_DOMAIN=salesmaker-20-web.vercel.app

# ← The password every seeded demo user signs in with. The demo is on the internet: make it long.
SEED_PASSWORD=

# Demo workspace → its own vercel.app address (add each one in Vercel → Settings → Domains).
DEMO_ALIASES=pixelcraft-demo=pixelcraft-demo-salesmaker.vercel.app,aurelia-demo=aurelia-demo-salesmaker.vercel.app

# Fixed settings; no need to change.
NODE_ENV=production
LOG_LEVEL=info
CELL_ID=eu-central-1
CELL_SERVICE_KID=demo-cell-1
AUTH_JWT_KID=demo-1
SECRETS_KEY_ID=demo-1
AUTH_JWT_PRIVATE_KEY_PATH=/keys/jwt-ed25519.pem
CELL_SERVICE_PRIVATE_KEY_PATH=/keys/cell-service-ed25519.pem
CONTROL_API_BASE_URL=http://control-api:4100
REDIS_URL=redis://valkey:6379
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=SalesMaker Demo <demo@salesmaker.invalid>
WEB_URL_SCHEME=https
BREACHED_PASSWORD_API_URL=https://api.pwnedpasswords.com
# Neon's free compute sleeps when idle; a slower sweep lets it.
RELAY_SWEEP_SECONDS=300
